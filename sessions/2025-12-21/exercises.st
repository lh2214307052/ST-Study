(*
===============================================================================
  第一天练习: 单电机启停控制
===============================================================================
  功能: 单台电机启停,含急停/互锁/报警
  日期: 2025-12-21
  
  功能需求:
  1. 按启动按钮 → 电机运行,松手仍运行(自保持)
  2. 按停止按钮 → 电机停止
  3. 急停优先(任何情况下都能停止)
  4. 停止优先于启动(同时按时停止)
  5. 过载保护(模拟: 运行超过 10 秒触发过载报警)
  6. 报警锁存(过载后必须复位才能重新启动)
  
  提示:
  - 先完成基础启停
  - 再添加急停
  - 最后加报警功能
  - AI 导师会引导你一步步完成
===============================================================================
*)

PROGRAM PRG_MotorControl

VAR
    // ========================================
    // 输入信号(模拟按钮,实际应从 I/O 映射)
    // ========================================
    iStartButton    : BOOL := FALSE;    // 启动按钮
    iStopButton     : BOOL := FALSE;    // 停止按钮
    iEmergencyStop  : BOOL := FALSE;    // 急停按钮
    iResetButton    : BOOL := FALSE;    // 报警复位按钮
    
    // ========================================
    // 输出信号
    // ========================================
    oMotorRun       : BOOL;             // 电机运行输出(接接触器)
    oAlarmLamp      : BOOL;             // 报警灯
    
    // ========================================
    // 内部变量
    // ========================================
    bRunning        : BOOL := FALSE;    // 运行状态
    bAlarmLatched   : BOOL := FALSE;    // 报警锁存
    bOverload       : BOOL := FALSE;    // 过载
    // ========================================
    // 边沿检测
    // ========================================
    rtStart         : R_TRIG;           // 启动上升沿
    rtReset         : R_TRIG;           // 复位上升沿
    
    // ========================================
    // 定时器
    // ========================================
    tRunTimer       : TON;              // 运行计时(用于模拟过载)
END_VAR

VAR CONSTANT
    // ========================================
    // 常量定义(禁止魔法数字)
    // ========================================
    OVERLOAD_TIME   : TIME := T#10s;    // 过载时间阈值
END_VAR

// ============================================================================
// 主程序开始
// ============================================================================

// ========================================
// TODO 1: 边沿检测
// ========================================
// 提示: 
// - R_TRIG 用于检测上升沿(FALSE → TRUE 的瞬间)
// - 为什么启动需要边沿,停止不需要?思考一下!

rtStart(CLK := iStartButton);  // TODO: 填入启动按钮信号
rtReset(CLK := iResetButton);  // TODO: 填入复位按钮信号


// ========================================
// TODO 2: 急停优先处理(最高优先级)
// ========================================
// 提示:
// - 急停应该立即停止电机,不管当前状态
// - 急停触发后,bRunning 应该变为 FALSE
// - 可以用 RETURN 提前退出程序,避免后续逻辑执行

IF iEmergencyStop THEN  // 急停时立即停止
    bRunning := FALSE;
    oMotorRun := FALSE;
    RETURN;  // 提前退出,不执行后续逻辑
END_IF


// ========================================
// TODO 3: 报警复位
// ========================================
// 提示:
// - 用上升沿检测复位按钮(避免一直按住时重复复位)
// - 复位时清除 bAlarmLatched

IF rtReset.Q THEN
    bAlarmLatched := FALSE;  // 清除报警锁存
END_IF


// ========================================
// TODO 4: 报警锁存时禁止启动
// ========================================
// 提示:
// - 如果有报警,不允许启动
// - 可以用 IF NOT bAlarmLatched THEN ... 包住启停逻辑

// ========================================
// TODO 5: 启动逻辑(自保持)
// ========================================
// 提示:
// - 启动条件: (启动上升沿 OR 已运行) AND NOT 停止 AND NOT 急停
// - 为什么用 OR? 因为要"自保持"(启动后松手仍运行)
// - 为什么用上升沿而不是直接用 iStartButton?

IF NOT bAlarmLatched THEN  // 无报警时才允许启停
    
    // 启动逻辑:上升沿触发或自保持,且未按停止/急停
    IF (rtStart.Q OR bRunning) AND NOT iStopButton AND NOT iEmergencyStop THEN
        bRunning := TRUE;
    END_IF
    
    // ========================================
    // TODO 6: 停止逻辑
    // ========================================
    // 提示:
    // - 停止按钮按下 → bRunning := FALSE
    // - 为什么停止不需要上升沿?(想想看!)
    
    // 停止逻辑:按停止或急停
    IF iStopButton OR iEmergencyStop THEN
        bRunning := FALSE;
    END_IF
    
END_IF


// ========================================
// TODO 7: 过载检测(运行超过10秒)
// ========================================
// 提示:
// - TON 定时器: IN 接触发条件, PT 接预设时间, Q 输出到时间为 TRUE
// - 如果运行时间超过 OVERLOAD_TIME,触发报警锁存
// - 报警触发后,电机应该停止

tRunTimer(IN := bRunning, PT := OVERLOAD_TIME);

IF tRunTimer.Q THEN
    bAlarmLatched := TRUE;   // 触发报警锁存
    bRunning := FALSE;        // 停止电机
END_IF


// ========================================
// TODO 8: 输出赋值
// ========================================
// 提示:
// - oMotorRun 接电机接触器
// - oAlarmLamp 接报警灯

oMotorRun := bRunning;
oAlarmLamp := bAlarmLatched;

END_PROGRAM


(*
